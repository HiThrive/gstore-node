{
  "name": "gstore-node",
  "version": "9.0.0",
  "description": "Google Datastore Entities Modeling for Node.js. Validate the Entity properties and type before saving to the Datastore. Advanced cache to speed up entities fetching.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rm -rf ./lib && tsc",
    "postbuild": "bash scripts/post_build.sh",
    "commit": "git-cz",
    "cover": "npm run test:unit -- --coverage",
    "lint": "eslint ./src ./__tests__",
    "local-datastore": "gcloud beta emulators datastore start --consistency=1.0 --no-store-on-disk",
    "pretest": "npm run lint",
    "release": "npm run build && standard-version",
    "test": "DATASTORE_EMULATOR_HOST=localhost:8081 jest --coverage",
    "test:unit": "jest --c=jest.config.unit.js --coverage",
    "test:integration": "DATASTORE_EMULATOR_HOST=localhost:8081 jest --c=jest.config.integration.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "google datastore",
    "gcloud node",
    "google app engine",
    "node.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sebelga/gstore-node.git"
  },
  "author": "Sébastien Loix",
  "contributors": [
    {
      "name": "Sébastien Loix",
      "url": "https://github.com/sebelga"
    },
    {
      "name": "Micah Allen",
      "url": "https://github.com/micaww"
    },
    {
      "name": "Ricardo Machado",
      "url": "https://github.com/mAiNiNfEcTiOn"
    },
    {
      "name": "jfbenckhuijsen",
      "url": "https://github.com/jfbenckhuijsen"
    },
    {
      "name": "Hendrik J. Schalekamp",
      "url": "https://github.com/carnun"
    }
  ],
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "arrify": "^2.0.1",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "extend": "^3.0.2",
    "is": "^3.3.2",
    "nsql-cache": "^1.1.5",
    "nsql-cache-datastore": "^1.1.6",
    "optional": "^0.1.4",
    "promised-hooks": "^3.1.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google-cloud/datastore": "^10.1.1",
    "@types/chai": "^4.3.20",
    "@types/chance": "^1.1.8",
    "@types/extend": "^3.0.4",
    "@types/is": "^0.0.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@types/sinon": "^17.0.4",
    "@types/validator": "^13.15.10",
    "cache-manager-redis-store": "^2.0.0",
    "chai": "^4.5.0",
    "chance": "^1.1.13",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "joi": "^17.13.3",
    "prettier": "^3.5.3",
    "redis-mock": "^0.56.3",
    "rimraf": "^6.0.1",
    "sinon": "^22.1.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "peerDependencies": {
    "@google-cloud/datastore": ">=6.0.0 <11"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "^6.1.4"
    },
    "gaxios": {
      "rimraf": "^6.1.4"
    }
  }
}
